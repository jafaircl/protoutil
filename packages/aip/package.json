{
  "name": "@protoutil/aip",
  "type": "module",
  "version": "0.3.3",
  "description": "TypeScript utilities for implementing Google API Improvement Proposals",
  "author": "Jonathan Faircloth <jonathan@faircloth.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/jafaircl/protoutil/tree/main/packages/aip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jafaircl/protoutil.git"
  },
  "bugs": {
    "url": "https://github.com/jafaircl/protoutil/issues"
  },
  "exports": {
    "./errors": {
      "import": "./dist/errors/index.mjs",
      "require": "./dist/errors/index.cjs"
    },
    "./etag": {
      "import": "./dist/etag/index.mjs",
      "require": "./dist/etag/index.cjs"
    },
    "./fieldbehavior": {
      "import": "./dist/fieldbehavior/index.mjs",
      "require": "./dist/fieldbehavior/index.cjs"
    },
    "./filtering": {
      "import": "./dist/filtering/index.mjs",
      "require": "./dist/filtering/index.cjs"
    },
    "./orderby": {
      "import": "./dist/orderby/index.mjs",
      "require": "./dist/orderby/index.cjs"
    },
    "./pagination": {
      "import": "./dist/pagination/index.mjs",
      "require": "./dist/pagination/index.cjs"
    },
    "./resourcename": {
      "import": "./dist/resourcename/index.mjs",
      "require": "./dist/resourcename/index.cjs"
    },
    "./gen/*.js": {
      "require": "./dist/gen/*.cjs",
      "import": "./dist/gen/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pretest": "pnpm --filter @protoutil/testing build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @protoutil/testing build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "protogen": "buf generate"
  },
  "devDependencies": {
    "@protoutil/testing": "workspace:*",
    "@bufbuild/protocompile": "^0.0.1",
    "@types/node": "^25.0.3",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@protoutil/core": "workspace:*"
  }
}
