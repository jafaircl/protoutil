{
  "name": "@protoutil/core",
  "type": "module",
  "version": "0.3.2",
  "description": "Protobuf-es utilities for checksums, field access, integer helpers, and well-known types.",
  "author": "Jonathan Faircloth <jonathan@faircloth.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/jafaircl/protoutil/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jafaircl/protoutil.git"
  },
  "bugs": {
    "url": "https://github.com/jafaircl/protoutil/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./google/rpc": {
      "import": "./dist/google/rpc/index.mjs",
      "require": "./dist/google/rpc/index.cjs"
    },
    "./google/type": {
      "import": "./dist/google/type/index.mjs",
      "require": "./dist/google/type/index.cjs"
    },
    "./wkt": {
      "import": "./dist/wkt/index.mjs",
      "require": "./dist/wkt/index.cjs"
    },
    "./gen/*.js": {
      "require": "./dist/gen/*.cjs",
      "import": "./dist/gen/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pretest": "pnpm --filter @protoutil/testing build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @protoutil/testing build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "protogen": "buf generate",
    "update:currencies": "node ./scripts/update-currency-codes.mjs",
    "update:region-codes": "node ./scripts/update-region-codes.mjs"
  },
  "devDependencies": {
    "@protoutil/testing": "workspace:*",
    "@types/node": "^25.0.3",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "crc": "^4.3.2"
  }
}
