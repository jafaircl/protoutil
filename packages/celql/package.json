{
  "name": "@protoutil/celql",
  "type": "module",
  "version": "0.3.2",
  "description": "Translate checked CEL expressions into dialect-defined query predicates.",
  "author": "Jonathan Faircloth <jonathan@faircloth.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/jafaircl/protoutil/tree/main/packages/celql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jafaircl/protoutil.git"
  },
  "bugs": {
    "url": "https://github.com/jafaircl/protoutil/issues"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./ansisql": {
      "require": "./dist/ansisql/index.cjs",
      "import": "./dist/ansisql/index.mjs"
    },
    "./mongodb": {
      "require": "./dist/mongodb/index.cjs",
      "import": "./dist/mongodb/index.mjs"
    },
    "./mysql": {
      "require": "./dist/mysql/index.cjs",
      "import": "./dist/mysql/index.mjs"
    },
    "./postgresql": {
      "require": "./dist/postgresql/index.cjs",
      "import": "./dist/postgresql/index.mjs"
    },
    "./sqlite": {
      "require": "./dist/sqlite/index.cjs",
      "import": "./dist/sqlite/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "protogen": "buf generate"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.18.0",
    "better-sqlite3": "^12.6.2",
    "mongodb": "^6.16.0",
    "mysql2": "^3.14.0",
    "pg": "^8.20.0",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@protoutil/cel": "workspace:*",
    "@protoutil/core": "workspace:*"
  }
}
