  name: "full_text_search_target_query_syntax_rejected"
  description: "Every binding rejects a query that contains target query-language syntax."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "search.matchesText(\"+error -\\\"budget\\\"\")"
