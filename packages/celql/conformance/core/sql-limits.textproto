# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Limits measured over the output. These depend on what the profile emits, so
# they belong here rather than in the core suite. The profile counts output
# growth as Unicode code points of the emitted condition.

name: "celql-core-sql-limits"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "name" ident { type { primitive: STRING } } }
  declarations { name: "a" ident { type { primitive: STRING } } }
  declarations { name: "b" ident { type { primitive: STRING } } }
  declarations { name: "status" ident { type { primitive: STRING } } }
}

cases {
  name: "output_growth_at_limit_accepted"
  description: "A condition whose length equals the configured growth limit is accepted. The emitted text is 10 code points."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"alice\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    limits { max_output_growth: 10 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    limits { max_output_growth: 10 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    limits { max_output_growth: 29 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    limits { max_output_growth: 29 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    limits { max_output_growth: 29 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED }
  }
}

cases {
  name: "output_growth_over_limit_rejected"
  description: "A condition longer than the configured growth limit is refused while the output is generated, not after it is complete. Each profile carries the limit that its own equality syntax exceeds or fits."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"alice\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    limits { max_output_growth: 9 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    limits { max_output_growth: 9 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    limits { max_output_growth: 28 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    limits { max_output_growth: 28 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    limits { max_output_growth: 28 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED }
  }
}

cases {
  name: "parameter_count_at_limit_accepted"
  description: "A translation emitting exactly the permitted number of parameters is accepted."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "a == \"x\" && b == \"y\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    limits { max_parameters: 2 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"a\" = ? AND \"b\" = ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "y" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    limits { max_parameters: 2 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(\"a\" = $1 AND \"b\" = $2)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "y" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    limits { max_parameters: 2 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(`a` <=> ? AND `b` <=> ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "y" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    limits { max_parameters: 2 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"a\" IS ? AND \"b\" IS ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "y" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    limits { max_parameters: 2 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$and" } value { list_value { values { map_value { entries { key { string_value: "a" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x" } } } } } } } values { map_value { entries { key { string_value: "b" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "y" } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "parameter_count_over_limit_rejected"
  description: "A translation that would emit more parameters than permitted is refused."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "a == \"x\" && b == \"y\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    limits { max_parameters: 1 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    limits { max_parameters: 1 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    limits { max_parameters: 1 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    limits { max_parameters: 1 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    limits { max_parameters: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$and" } value { list_value { values { map_value { entries { key { string_value: "a" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x" } } } } } } } values { map_value { entries { key { string_value: "b" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "y" } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "membership_counts_one_parameter_per_element"
  description: "A membership test emits one parameter per element, so a list can exceed the parameter limit on its own."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "status in [\"a\", \"b\", \"c\"]"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    limits { max_parameters: 2 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    limits { max_parameters: 2 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    limits { max_parameters: 2 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    limits { max_parameters: 2 }
    error { code: TRANSLATION_ERROR_CODE_RESOURCE_LIMIT_EXCEEDED expression_node_id: 6 }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    limits { max_parameters: 2 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "status" } value { map_value { entries { key { string_value: "$in" } value { list_value { values { string_value: "a" } values { string_value: "b" } values { string_value: "c" } } } } } } } } }
    } } }
  }
}
