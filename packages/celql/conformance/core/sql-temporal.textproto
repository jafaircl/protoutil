cases {
  name: "malformed_timestamp_argument_rejected"
  description: "An argument that is not a valid RFC 3339 timestamp cannot be folded, so the call is refused rather than passed through as text."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "created_at > timestamp(\"not-a-timestamp\")"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
}

