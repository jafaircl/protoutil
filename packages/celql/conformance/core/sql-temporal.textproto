    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"timeout\" >= $1"
      parameters { cel_type { well_known: DURATION } value { object_value { [type.googleapis.com/google.protobuf.Duration] { seconds: 60 } } } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`timeout` >= ?"
      parameters { cel_type { well_known: DURATION } value { object_value { [type.googleapis.com/google.protobuf.Duration] { seconds: 60 } } } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"timeout\" >= ?"
      parameters { cel_type { well_known: DURATION } value { object_value { [type.googleapis.com/google.protobuf.Duration] { seconds: 60 } } } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
}

cases {
  name: "duration_strict_upper_bound"
  description: "The strict upper-bound overload on durations."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "timeout < duration(\"60s\")"
  expected {
