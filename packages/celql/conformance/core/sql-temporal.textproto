    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"created_at\" <= ?"
      parameters { cel_type { well_known: TIMESTAMP } value { object_value { [type.googleapis.com/google.protobuf.Timestamp] { seconds: 1704067200 } } } }
    } } }
  }
