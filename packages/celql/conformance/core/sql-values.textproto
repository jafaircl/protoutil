# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Identifier delimiting, null handling, value ranges, and parameter binding for
# the ANSI SQL profile.

name: "celql-core-sql-values"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "name" ident { type { primitive: STRING } } }
  declarations { name: "nickname" ident { type { primitive: STRING } } }
  declarations { name: "count" ident { type { primitive: INT64 } } }
  declarations { name: "size" ident { type { primitive: UINT64 } } }
  declarations { name: "payload" ident { type { primitive: BYTES } } }
  declarations { name: "user" ident { type { message_type: "example.User" } } }
}
cases {
  name: "selection_path_is_delimited_per_component"
  description: "Each path component is delimited separately, so the separator stays a qualifier rather than becoming part of a name."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "user.email == \"a@example.com\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"user\".\"email\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "a@example.com" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"user\".\"email\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "a@example.com" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`user`.`email` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "a@example.com" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"user\".\"email\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "a@example.com" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 2 }
  }
}

cases {
  name: "absence_observation_rejected"
  description: "SQL cannot distinguish an absent column from a null column, so the lowered has() form is outside the fragment."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "has(user.email)"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
}

cases {
  name: "null_equality_emits_is_null"
  description: "SQL equality against NULL yields unknown, so CEL equality against null emits the null test to select the same rows."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == null"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" IS NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 3 }
  }
}

cases {
  name: "null_inequality_emits_is_not_null"
  description: "Inequality against null emits the negated null test and binds nothing."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name != null"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS NOT NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" IS NOT NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "NOT (`name` <=> NULL)"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS NOT NULL"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 3 }
  }
}

cases {
  name: "int64_minimum_binds_exactly"
  description: "The smallest signed 64-bit value binds without loss."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "count == -9223372036854775808"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"count\" = ?"
      parameters { cel_type { primitive: INT64 } value { int64_value: -9223372036854775808 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"count\" = $1"
      parameters { cel_type { primitive: INT64 } value { int64_value: -9223372036854775808 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`count` <=> ?"
      parameters { cel_type { primitive: INT64 } value { int64_value: -9223372036854775808 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"count\" IS ?"
      parameters { cel_type { primitive: INT64 } value { int64_value: -9223372036854775808 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "count" } value { map_value { entries { key { string_value: "$eq" } value { int64_value: -9223372036854775808 } } } } } } }
    } } }
  }
}

cases {
  name: "uint64_at_signed_maximum_binds"
  description: "An unsigned value at the signed maximum is representable and binds as an unsigned value."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "size == 9223372036854775807u"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"size\" = ?"
      parameters { cel_type { primitive: UINT64 } value { uint64_value: 9223372036854775807 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"size\" = $1"
      parameters { cel_type { primitive: UINT64 } value { uint64_value: 9223372036854775807 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`size` <=> ?"
      parameters { cel_type { primitive: UINT64 } value { uint64_value: 9223372036854775807 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"size\" IS ?"
      parameters { cel_type { primitive: UINT64 } value { uint64_value: 9223372036854775807 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "size" } value { map_value { entries { key { string_value: "$eq" } value { uint64_value: 9223372036854775807 } } } } } } }
    } } }
  }
}

cases {
  name: "uint64_above_signed_maximum_rejected"
  description: "Exact numeric types in SQL are signed, so a larger unsigned value has no portable representation and is refused rather than narrowed."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "size == 9223372036854775808u"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSAFE_TRANSLATION expression_node_id: 3 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSAFE_TRANSLATION expression_node_id: 3 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSAFE_TRANSLATION expression_node_id: 3 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSAFE_TRANSLATION expression_node_id: 3 }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSAFE_TRANSLATION }
  }
}

cases {
  name: "bytes_bind_without_text_encoding"
  description: "A bytes value binds as bytes, including a null octet, so no text encoding step can alter or truncate it."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "payload == b\"\\x00\\x01' OR 1=1 --\\xff\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"payload\" = ?"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"payload\" = $1"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`payload` <=> ?"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"payload\" IS ?"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "payload" } value { map_value { entries { key { string_value: "$eq" } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } } } } } } }
    } } }
  }
}

cases {
  name: "injection_text_stays_in_the_parameter"
  description: "A hostile string reaches the parameter list unchanged and never reaches the condition text."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"x' OR 1=1 --\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x' OR 1=1 --" } } } } } } }
    } } }
  }
}

cases {
  name: "repeated_values_bind_once_each"
  description: "Markers are unnumbered and bound by position, so an equal value repeated twice produces two markers and two entries."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"x\" && nickname == \"x\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"name\" = ? AND \"nickname\" = ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(\"name\" = $1 AND \"nickname\" = $2)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(`name` <=> ? AND `nickname` <=> ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"name\" IS ? AND \"nickname\" IS ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$and" } value { list_value { values { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x" } } } } } } } values { map_value { entries { key { string_value: "nickname" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x" } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "boolean_literal_root_matches_all"
  description: "A Boolean literal root reduces to the unconditional outcome rather than to a tautological condition."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "true"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { match_all {} }
  }
}

cases {
  name: "boolean_literal_root_matches_none"
  description: "A false Boolean literal root reduces to the unconditional no-match outcome."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "false"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { match_none {} }
  }
}

cases {
  name: "reserved_word_column_is_delimited"
  description: "Delimiting lets a column named with a reserved word survive, because a delimited identifier is never read as a keyword."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  environment {
    declarations { name: "select" ident { type { primitive: STRING } } }
  }
  cel_source: "select == \"x\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"select\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"select\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`select` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"select\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "select" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x" } } } } } } }
    } } }
  }
}

cases {
  name: "embedded_quote_in_identifier_is_doubled"
  description: "A double quote inside a backtick-escaped component is doubled, so a hostile column name cannot close the delimiter early."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  environment {
    declarations {
      name: "resource"
      ident { type { map_type { key_type { primitive: STRING } value_type { primitive: STRING } } } }
    }
  }
  cel_source: "resource.`a\"; DROP TABLE t; --` == \"x\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"resource\".\"a\"\"; DROP TABLE t; --\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
