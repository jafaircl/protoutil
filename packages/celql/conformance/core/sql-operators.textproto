# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Equality, logical operators, and their behavior under negation.
#
# Equality emits the distinct predicate rather than =, because CEL equality is
# total while SQL = yields unknown on a null operand. The negation cases are
# where that difference becomes visible.

name: "celql-core-sql-operators"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "name" ident { type { primitive: STRING } } }
  declarations { name: "nickname" ident { type { primitive: STRING } } }
  declarations { name: "age" ident { type { primitive: INT64 } } }
  declarations { name: "active" ident { type { primitive: BOOL } } }
}
cases {
  name: "equality_against_constant"
  description: "Equality emits the distinct predicate. The value never appears in the condition text."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"alice\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "alice" } } } } } } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    profile_configuration { [type.googleapis.com/google.protobuf.Empty] {} }
    error { code: TRANSLATION_ERROR_CODE_INVALID_PROFILE_CONFIGURATION }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    profile_configuration { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlConfiguration] {} }
    error { code: TRANSLATION_ERROR_CODE_INVALID_PROFILE_CONFIGURATION }
  }
}

cases {
  name: "inequality_against_constant"
  description: "Inequality emits the distinct predicate. Plain <> would yield unknown for a null column and would exclude a row that CEL selects."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name != \"alice\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS DISTINCT FROM ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" IS DISTINCT FROM $1"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "NOT (`name` <=> ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS NOT ?"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$ne" } value { string_value: "alice" } } } } } } }
    } } }
  }
}

cases {
  name: "constant_on_the_left"
  description: "Operand order is preserved, so a constant on the left emits the marker on the left."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "\"alice\" == name"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "? = \"name\""
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "$1 = \"name\""
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "? <=> `name`"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "? IS \"name\""
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "alice" } } } } } } }
    } } }
  }
}

cases {
  name: "field_to_field_comparison_binds_nothing"
  description: "Both operands may be columns. No parameter is emitted."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == nickname"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS NOT DISTINCT FROM \"nickname\""
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" IS NOT DISTINCT FROM \"nickname\""
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> `nickname`"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS \"nickname\""
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
}

cases {
  name: "conjunction_is_parenthesized"
  description: "A composite condition is parenthesized, so a caller can combine it with other conditions without adding parentheses."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"alice\" && age > 21"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"name\" = ? AND \"age\" > ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(\"name\" = $1 AND \"age\" > $2)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(`name` <=> ? AND `age` > ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"name\" IS ? AND \"age\" > ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$and" } value { list_value { values { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "alice" } } } } } } } values { map_value { entries { key { string_value: "age" } value { map_value { entries { key { string_value: "$gt" } value { int64_value: 21 } } } } } } } } } } } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    profile_configuration { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlConfiguration] {
      start_position: 5
    } }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(\"name\" = $5 AND \"age\" > $6)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
}

cases {
  name: "disjunction_preserves_grouping"
  description: "Nested Boolean operators keep the grouping of the expression tree, because AND binds tighter than OR in SQL."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"alice\" || (name == \"bob\" && age > 21)"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"name\" = ? OR (\"name\" = ? AND \"age\" > ?))"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: STRING } value { string_value: "bob" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(\"name\" = $1 OR (\"name\" = $2 AND \"age\" > $3))"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: STRING } value { string_value: "bob" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(`name` <=> ? OR (`name` <=> ? AND `age` > ?))"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: STRING } value { string_value: "bob" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"name\" IS ? OR (\"name\" IS ? AND \"age\" > ?))"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
      parameters { cel_type { primitive: STRING } value { string_value: "bob" } }
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$or" } value { list_value { values { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "alice" } } } } } } } values { map_value { entries { key { string_value: "$and" } value { list_value { values { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "bob" } } } } } } } values { map_value { entries { key { string_value: "age" } value { map_value { entries { key { string_value: "$gt" } value { int64_value: 21 } } } } } } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "negated_equality_stays_total"
  description: "CEL equality is total, so its negation selects a row whose column is null. A plain = under NOT would yield unknown and drop that row."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "!(name == \"alice\")"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT \"name\" IS NOT DISTINCT FROM ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(NOT \"name\" IS NOT DISTINCT FROM $1)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT `name` <=> ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT \"name\" IS ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$nor" } value { list_value { values { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "alice" } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "negated_ordering_carries_no_null_guard"
  description: "An ordering comparison on a null operand is a CEL error, and a SQL unknown propagates the same way, so the two already agree under negation. A null guard here would break that agreement."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "!(age > 21)"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT \"age\" > ?)"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(NOT \"age\" > $1)"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT `age` > ?)"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT \"age\" > ?)"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$nor" } value { list_value { values { map_value { entries { key { string_value: "age" } value { map_value { entries { key { string_value: "$gt" } value { int64_value: 21 } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "negated_null_test_stays_total"
  description: "A null test is already total, so negating it needs no further guard."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "!(name == null)"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT \"name\" IS NULL)"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(NOT \"name\" IS NULL)"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT `name` <=> NULL)"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(NOT \"name\" IS NULL)"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION expression_node_id: 4 }
  }
}

cases {
  name: "boolean_column_operand_accepted"
  description: "A Boolean column is a valid logical operand and emits the Boolean column form beside the comparison."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "active && name == \"alice\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"active\" = TRUE AND \"name\" = ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "(\"active\" = TRUE AND \"name\" = $1)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(`active` = TRUE AND `name` <=> ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "(\"active\" = TRUE AND \"name\" IS ?)"
      parameters { cel_type { primitive: STRING } value { string_value: "alice" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "$and" } value { list_value { values { map_value { entries { key { string_value: "active" } value { map_value { entries { key { string_value: "$eq" } value { bool_value: true } } } } } } } values { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "alice" } } } } } } } } } } } }
    } } }
  }
}

cases {
  name: "constant_to_constant_comparison_rejected"
  description: "Two constants form no condition on a record, so the operand-shape combination is outside the fragment."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "\"a\" == \"b\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
