# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# A constant carries data and never becomes query structure. These cases assert
# the exact condition text, so a value that leaks into the text fails: the
# expected text contains a marker where the value would otherwise appear.

name: "celql-core-security"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "name" ident { type { primitive: STRING } } }
  declarations { name: "payload" ident { type { primitive: BYTES } } }
  declarations {
    name: "neverSupported"
    function {
      overloads {
        overload_id: "celql.reserved.unsupported.string_call"
        params { primitive: STRING }
        result_type { primitive: BOOL }
      }
    }
  }
}

cases {
  name: "statement_syntax_in_a_string_stays_a_parameter"
  description: "A string carrying a quote, a disjunction, and a comment introducer reaches the parameter list unchanged and leaves no trace in the condition."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"x' OR 1=1 --\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "x' OR 1=1 --" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "x' OR 1=1 --" } } } } } } }
    } } }
  }
}

cases {
  name: "statement_terminator_in_a_string_stays_a_parameter"
  description: "A string carrying a statement terminator and a block comment opener cannot end the condition or hide the rest of it."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == 'a\"; DROP TABLE t; /*'"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "a\"; DROP TABLE t; /*" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "a\"; DROP TABLE t; /*" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "a\"; DROP TABLE t; /*" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "a\"; DROP TABLE t; /*" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "a\"; DROP TABLE t; /*" } } } } } } }
    } } }
  }
}

cases {
  name: "marker_syntax_in_a_string_stays_a_parameter"
  description: "A string that looks like a parameter marker does not become one, so the marker count still matches the parameter count."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"? $1 :name\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "? $1 :name" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "? $1 :name" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "? $1 :name" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "? $1 :name" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "? $1 :name" } } } } } } }
    } } }
  }
}

cases {
  name: "empty_string_binds_as_a_value"
  description: "An empty string is a value rather than an absent operand, so it still produces a marker and an entry."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "name == \"\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"name\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`name` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"name\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "name" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "" } } } } } } }
    } } }
  }
}

cases {
  name: "non_printable_bytes_stay_a_parameter"
  description: "A bytes value containing a null octet and a high octet binds as bytes, so no text encoding step can alter or truncate it."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "payload == b\"\\x00\\x01' OR 1=1 --\\xff\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"payload\" = ?"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"payload\" = $1"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`payload` <=> ?"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"payload\" IS ?"
      parameters { cel_type { primitive: BYTES } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "payload" } value { map_value { entries { key { string_value: "$eq" } value { bytes_value: "\x00\x01\x27\x20\x4f\x52\x20\x31\x3d\x31\x20\x2d\x2d\xff" } } } } } } }
    } } }
  }
}

cases {
  name: "hostile_constant_does_not_rescue_a_rejected_expression"
  description: "A constant cannot supply query structure. An expression that is otherwise untranslatable stays rejected whatever its constants contain."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "neverSupported(\"x' OR 1=1 --\") && true"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 1 }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 1 }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 1 }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 1 }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 1 }
  }
}
