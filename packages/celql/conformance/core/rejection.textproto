# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Rejection behavior that holds for every profile. These cases declare a
# function whose overload uses the reserved prefix
# `celql.reserved.unsupported.`, which no profile may declare, so a rejection
# occurs whichever profile the runner selects.

name: "celql-core-rejection"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "status" ident { type { primitive: STRING } } }
  declarations {
    name: "neverSupported"
    function {
      overloads {
        overload_id: "celql.reserved.unsupported.boolean_call"
        params { primitive: BOOL }
        result_type { primitive: BOOL }
      }
    }
  }
}

cases {
  name: "reserved_unsupported_overload_rejected"
  description: "An overload that no profile may declare is refused."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "neverSupported(true)"
  error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD }
}

cases {
  name: "atomic_failure_across_branches"
  description: "One untranslatable branch fails the whole translation. A translator does not return the translatable branch alone, because dropping a conjunct would widen the matched set."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  profile { name: "protoutil.celql.ansisql" major_version: 1 }
  cel_source: "status == \"active\" && neverSupported(true)"
  error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD }
}

cases {
  name: "atomic_failure_under_disjunction"
  description: "One untranslatable disjunct fails the whole translation. Dropping a disjunct would narrow the matched set."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  profile { name: "protoutil.celql.ansisql" major_version: 1 }
  cel_source: "status == \"active\" || neverSupported(true)"
  error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD }
}

cases {
  name: "validate_reports_unsupported_overload"
  description: "Validation reports fragment rejection without producing output."
  operation: CONFORMANCE_OPERATION_VALIDATE
  cel_source: "neverSupported(true)"
  error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD }
}
