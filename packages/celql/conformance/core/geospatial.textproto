}

cases {
  name: "geo_point_latitude_out_of_range_rejected"
  description: "Every spatial binding rejects a position outside the WGS 84 coordinate ranges."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "location.geoWithinDistance(geoPoint(0.0, 91.0), 1000.0)"
  expected { profile { name: "protoutil.celql.ansisql" major_version: 1 } error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD } }
