# proto-message: protoutil.celql.conformance.v1.ConformanceSuite

name: "celql-core-native-arrays"
specification_version: "0.12"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "tags" ident { type { list_type { elem_type { primitive: STRING } } } } }
}

cases {
  name: "string_constant_in_string_array"
  description: "A native string-array field selects records that contain the constant string."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "\"admin\" in tags"
  expected { profile { name: "protoutil.celql.ansisql" major_version: 1 } error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD } }
  expected { profile { name: "protoutil.celql.postgresql" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
    sql: "CASE WHEN \"tags\" IS NULL THEN NULL ELSE array_position(\"tags\", $1) IS NOT NULL END"
    parameters { cel_type { primitive: STRING } value { string_value: "admin" } }
  } } } }
  expected { profile { name: "protoutil.celql.mysql" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
    sql: "JSON_CONTAINS(`tags`, JSON_ARRAY(?))"
    parameters { cel_type { primitive: STRING } value { string_value: "admin" } }
  } } } }
  expected { profile { name: "protoutil.celql.sqlite" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
    sql: "EXISTS (SELECT 1 FROM json_each(\"tags\") AS \"__celql_element\" WHERE \"__celql_element\".value IS ?)"
    parameters { cel_type { primitive: STRING } value { string_value: "admin" } }
  } } } }
  expected { profile { name: "protoutil.celql.mongodb" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
    filter { map_value { entries { key { string_value: "tags" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "admin" } } } } } } }
  } } } }
}

cases {
  name: "string_array_equality_exists"
  description: "The canonical equality-based exists form has the same native-array selection semantics."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "tags.exists(tag, tag == \"admin\")"
  expected { profile { name: "protoutil.celql.ansisql" major_version: 1 } error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_EXPRESSION } }
  expected { profile { name: "protoutil.celql.postgresql" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
    sql: "CASE WHEN \"tags\" IS NULL THEN NULL ELSE array_position(\"tags\", $1) IS NOT NULL END"
    parameters { cel_type { primitive: STRING } value { string_value: "admin" } }
  } } } }
  expected { profile { name: "protoutil.celql.mysql" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
    sql: "JSON_CONTAINS(`tags`, JSON_ARRAY(?))"
    parameters { cel_type { primitive: STRING } value { string_value: "admin" } }
  } } } }
  expected { profile { name: "protoutil.celql.sqlite" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
    sql: "EXISTS (SELECT 1 FROM json_each(\"tags\") AS \"__celql_element\" WHERE \"__celql_element\".value IS ?)"
    parameters { cel_type { primitive: STRING } value { string_value: "admin" } }
  } } } }
  expected { profile { name: "protoutil.celql.mongodb" major_version: 1 } success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
    filter { map_value { entries { key { string_value: "tags" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "admin" } } } } } } }
  } } } }
}
