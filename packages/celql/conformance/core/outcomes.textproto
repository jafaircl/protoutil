# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Outcome kinds. A Boolean literal root has a required outcome under every
# profile, so those cases name no profile. A record-dependent expression must
# produce a predicate; those cases select the baseline profile and assert its
# exact output.

name: "celql-core-outcomes"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

environment {
  declarations { name: "status" ident { type { primitive: STRING } } }
}

cases {
  name: "bool_true_root_matches_all"
  description: "A Boolean true root is unconditionally true for every supported input domain."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "true"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { match_all {} }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { match_all {} }
  }
}

cases {
  name: "bool_false_root_matches_none"
  description: "A Boolean false root is unconditionally false, and is distinct from a predicate that selects nothing."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "false"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { match_none {} }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { match_none {} }
  }
}

cases {
  name: "validate_accepts_bool_literal_root"
  description: "Validation accepts an expression that translation can complete."
  operation: CONFORMANCE_OPERATION_VALIDATE
  cel_source: "true"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { valid {} }
  }
}

cases {
  name: "record_dependent_expression_produces_predicate"
  description: "An expression whose value depends on the record cannot reduce to a constant outcome, so translation produces a predicate rather than match_all or match_none."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "status == \"active\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"status\" = ?"
      parameters { cel_type { primitive: STRING } value { string_value: "active" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"status\" = $1"
      parameters { cel_type { primitive: STRING } value { string_value: "active" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`status` <=> ?"
      parameters { cel_type { primitive: STRING } value { string_value: "active" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"status\" IS ?"
      parameters { cel_type { primitive: STRING } value { string_value: "active" } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.mongodb.v1.MongoDbPredicate] {
      filter { map_value { entries { key { string_value: "status" } value { map_value { entries { key { string_value: "$eq" } value { string_value: "active" } } } } } } }
    } } }
  }
}

cases {
  name: "tautological_comparison_still_produces_predicate"
  description: "The baseline declares no reduction beyond a Boolean literal root, so an expression a reader can see is always true still produces a predicate."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "status == status"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"status\" IS NOT DISTINCT FROM \"status\""
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"status\" IS NOT DISTINCT FROM \"status\""
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "`status` <=> `status`"
    } } }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"status\" IS \"status\""
    } } }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_OVERLOAD expression_node_id: 2 }
  }
}

cases {
  name: "validate_accepts_translatable_expression"
  description: "Validation accepts a record-dependent expression inside the fragment and produces no output."
  operation: CONFORMANCE_OPERATION_VALIDATE
  cel_source: "status == \"active\""
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.mysql" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.sqlite" major_version: 1 }
    success { valid {} }
  }
  expected {
    profile { name: "protoutil.celql.mongodb" major_version: 1 }
    success { valid {} }
  }
}
