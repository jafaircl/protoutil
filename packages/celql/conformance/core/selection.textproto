# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Profile selection. These cases name a profile that no implementation may
# register, because the reference itself is what is under test.

name: "celql-core-selection"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_CORE

cases {
  name: "unregistered_profile_rejected"
  description: "An unregistered profile name is refused. No other profile is substituted, because silently changing dialects would change the meaning of the result."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "true"
  expected {
    profile { name: "celql.reserved.unregistered" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_PROFILE }
  }
}

cases {
  name: "unregistered_profile_rejected_before_expression_check"
  description: "Profile selection is resolved before the expression is examined, so an unregistered name outranks a non-Boolean root."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "\"x\""
  expected {
    profile { name: "celql.reserved.unregistered" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_PROFILE }
  }
}

cases {
  name: "validate_rejects_unregistered_profile"
  description: "Validation resolves the profile the same way translation does."
  operation: CONFORMANCE_OPERATION_VALIDATE
  cel_source: "true"
  expected {
    profile { name: "celql.reserved.unregistered" major_version: 1 }
    error { code: TRANSLATION_ERROR_CODE_UNSUPPORTED_PROFILE }
  }
}
