# proto-message: protoutil.celql.conformance.v1.ConformanceSuite
#
# Every declared ordering overload. The profile keys behavior on the resolved
# overload rather than the source function name, so each operand type gets its
# own case.
#
# None carries a null guard: an ordering comparison on a null operand is a CEL
# error, and a SQL unknown propagates identically.

name: "celql-profile-ansisql-comparisons"
specification_version: "0.11"
level: CONFORMANCE_LEVEL_PROFILE

environment {
  declarations { name: "age" ident { type { primitive: INT64 } } }
  declarations { name: "limit_age" ident { type { primitive: INT64 } } }
  declarations { name: "size" ident { type { primitive: UINT64 } } }
  declarations { name: "ratio" ident { type { primitive: DOUBLE } } }
  declarations { name: "name" ident { type { primitive: STRING } } }
}

cases {
  name: "less_int64"
  description: "A signed integer less-than comparison."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "age < 21"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"age\" < ?"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"age\" < $1"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
}

cases {
  name: "less_equals_int64"
  description: "A signed integer less-than-or-equal comparison."
  operation: CONFORMANCE_OPERATION_TRANSLATE
  cel_source: "age <= 21"
  expected {
    profile { name: "protoutil.celql.ansisql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.ansisql.v1.AnsiSqlPredicate] {
      sql: "\"age\" <= ?"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
  expected {
    profile { name: "protoutil.celql.postgresql" major_version: 1 }
    success { exact_predicate { [type.googleapis.com/protoutil.celql.postgresql.v1.PostgreSqlPredicate] {
      sql: "\"age\" <= $1"
      parameters { cel_type { primitive: INT64 } value { int64_value: 21 } }
    } } }
  }
}

