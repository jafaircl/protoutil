{
  "name": "@protoutil/repo",
  "type": "module",
  "version": "0.3.2",
  "description": "AIP-style protobuf repositories for SQLite, Postgres, MySQL, and MongoDB.",
  "author": "Jonathan Faircloth <jonathan@faircloth.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/jafaircl/protoutil/tree/main/packages/repo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jafaircl/protoutil.git"
  },
  "bugs": {
    "url": "https://github.com/jafaircl/protoutil/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./mongodb": {
      "import": "./dist/mongodb/index.mjs",
      "require": "./dist/mongodb/index.cjs"
    },
    "./mysql": {
      "import": "./dist/mysql/index.mjs",
      "require": "./dist/mysql/index.cjs"
    },
    "./postgres": {
      "import": "./dist/postgres/index.mjs",
      "require": "./dist/postgres/index.cjs"
    },
    "./sqlite": {
      "import": "./dist/sqlite/index.mjs",
      "require": "./dist/sqlite/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "bench": "node --import tsx src/repository.bench.ts",
    "dev": "tsdown --watch",
    "pack-check": "node ./scripts/pack-check.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "protogen": "buf generate"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0",
    "pg": ">=8.0.0",
    "mysql2": ">=3.0.0",
    "mongodb": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.18.0",
    "@types/node": "^25.0.3",
    "better-sqlite3": "^12.6.2",
    "mongodb": "^6.16.0",
    "mysql2": "^3.14.0",
    "pg": "^8.13.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@protoutil/aip": "workspace:*",
    "@protoutil/aipql": "workspace:*",
    "@protoutil/core": "workspace:*"
  }
}
